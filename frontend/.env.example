# Base URL for API calls in local development:
# - Use "/api" so Vite proxy can forward to FastAPI in dev
VITE_API_BASE_URL=/api

# On Render, you can set VITE_API_BASE_URL from the backend host.
# This code will normalize it into `${VITE_API_BASE_URL}/api`.
# Example (what Render might effectively provide):
#   VITE_API_BASE_URL=ai-career-mentor-backend.onrender.com
VITE_API_URL=
