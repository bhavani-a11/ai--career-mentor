# Copy this file to .env and edit values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS / Linux)

# App
APP_NAME=AI Career Mentor
API_VERSION=0.1.0
DEBUG=true

# CORS — comma-separated frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL Database (Neon or local)
DATABASE_URL=postgresql://neondb_owner:npg_M8YIjuhQZ1Uy@ep-broad-tooth-aojggkeo-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# GitHub Models — Personal Access Token with models scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token-here
GITHUB_MODEL=openai/gpt-4o-mini

# JWT Secret Key
SECRET_KEY=your-super-secret-key-here-please-change-in-production

# RAG — Hugging Face embedding model & chunking
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=4

# Storage paths (relative to backend/ folder)
UPLOADS_DIR=uploads
VECTOR_DB_DIR=vector_db
