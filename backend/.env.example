# Copy this file to .env and edit values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS / Linux)

# App
APP_NAME=AI Career Mentor
API_VERSION=0.1.0
DEBUG=true

# CORS — comma-separated frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=career_mentor

# Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (optional, for future LangChain features)
OPENAI_API_KEY=

# Storage paths (relative to backend/ folder)
UPLOADS_DIR=uploads
VECTOR_DB_DIR=vector_db
